{
	"schemaVersion": 1,
	"id": "waybettercoppergolem",
	"version": "${version}",
	"name": "Way Better Copper Golem",
	"description": "Copper golems that actually sort your storage room: label chests (or let the mod learn them from their contents), set zones with a feather, and golems deliver every item to the right chest.",
	"authors": [
		"lnasser11"
	],
	"contact": {
		"homepage": "https://github.com/lnasser11/waybettercoppergolem",
		"sources": "https://github.com/lnasser11/waybettercoppergolem"
	},
	"license": "CC0-1.0",
	"icon": "assets/waybettercoppergolem/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.lnasser11.waybettercoppergolem.WayBetterCopperGolem"
		],
		"client": [
			"io.github.lnasser11.waybettercoppergolem.client.WayBetterCopperGolemClient"
		]
	},
	"mixins": [
		"waybettercoppergolem.mixins.json",
		{
			"config": "waybettercoppergolem.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}